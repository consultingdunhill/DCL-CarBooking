{
  "name": "@carbooking/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@carbooking/core": "workspace:*",
    "@prisma/client": "~6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "~6.19.3",
    "tsx": "^4.23.15"
  }
}
