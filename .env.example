# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carbooking:carbooking@localhost:5433/carbooking?schema=public
NODE_ENV=development
API_PORT=4000
# Public URL of the web app (links in emails and notifications).
APP_URL=http://localhost:5173
# Public URL of the API (signed upload URLs, tracking sync URL for the mobile app).
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API. Capacitor apps use these origins.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Secret for trip tracking tokens, dev tokens and signed upload URLs. Use 32+ random bytes in production.
APP_SECRET=change-me-to-a-long-random-string

# ── Auth: Microsoft Entra ID ──────────────────────────────────────────────────
# AUTH_MODE=entra validates Entra ID tokens. AUTH_MODE=dev shows a user picker (never in production).
AUTH_MODE=dev
ENTRA_TENANT_ID=
# The API app registration (audience of access tokens), e.g. api://<client-id>
ENTRA_API_AUDIENCE=
# Users with this Entra app role become admins. Everyone else signed in is staff.
ENTRA_ADMIN_ROLE=Admin
ENTRA_STAFF_ROLE=Staff

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Server key (Routes API, Geocoding). Leave empty to use straight-line estimates.
GOOGLE_MAPS_SERVER_KEY=

# ── Hardware GPS trackers (the boxes fitted to the cars) ───────────────────────
# none    = off; trips tracked by the phone only (default)
# mock    = synthetic fixes for local dev (no network, no login; cars move on the map)
# oversee = Oversee Tracking (SignIn + GetMyTracker are wired). Switching this on
#           polls your Oversee account's live API every minute for active trips —
#           confirm that's acceptable under their terms before using it in production.
TRACKER_PROVIDER=mock
OVERSEE_API_URL=https://api.overseetracking.com:9090/WebProcessorApi.ashx
# Your own Oversee account. Keep real credentials out of git; set them only in .env.
OVERSEE_USERNAME=
OVERSEE_PASSWORD=
OVERSEE_LANGUAGE_TYPE=2B72ABC6-19D7-4653-AAEE-0BE542026D46
# Oversee's position times carry no timezone; we read them as UTC. If fixes land in
# the wrong window on first connect, set this (minutes to subtract to reach UTC).
OVERSEE_TZ_OFFSET_MIN=0

# ── Storage (odometer photos, receipts) ───────────────────────────────────────
# local = files under apps/api/storage. azure = Azure Blob Storage with SAS URLs.
STORAGE_DRIVER=local
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=carbooking

# ── Notifications ─────────────────────────────────────────────────────────────
# Web Push (PWA/desktop). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fleet@example.co.ke
# Firebase Cloud Messaging (iOS/Android app): service account JSON, base64-encoded.
FCM_SERVICE_ACCOUNT_BASE64=
# Email via Microsoft Graph from a shared mailbox (app registration with Mail.Send).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=fleet@example.co.ke
# Urgent alerts (urgent requests, overdue, tracking lost) go by SMS and WhatsApp.
# SMS: africastalking | twilio | none
SMS_PROVIDER=none
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# WhatsApp: baileys (link a company WhatsApp number by scanning a QR, no API fees;
# unofficial, so use a dedicated number) | twilio (WhatsApp Business API) | none
WHATSAPP_PROVIDER=none
# Where the linked session is kept (default: .whatsapp-auth in the repo). Must persist across restarts.
WHATSAPP_AUTH_DIR=
# Optional: link with an 8-character pairing code for this number instead of a QR.
WHATSAPP_PAIRING_NUMBER=

# ── Dunhill CRM (marketing.erp.dunhill-ticketing.com) ─────────────────────────
# Leave both blank to turn the link off. When set, the worker pulls the CRM's portfolio
# nightly and pushes viewings (stops booked for CRM leads) back to it within a minute.
# On the shared server use the CRM's address on the internal Docker network rather
# than the public one.
CRM_API_URL=
# The CRM's FLEET_INTEGRATION_TOKEN (at least 32 characters).
CRM_API_TOKEN=

# ── Web app (Vite reads VITE_* at build time) ─────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_AUTH_MODE=dev
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Scope for the API, e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
# Native app sign-in redirect (system browser → app). Must match the app ID in apps/mobile/capacitor.config.ts.
VITE_ENTRA_NATIVE_REDIRECT=ke.co.fleet.app://auth
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_VAPID_PUBLIC_KEY=
VITE_APP_NAME=Fleet
# Lets trips run in a desktop browser with foreground GPS, for development only.
VITE_ALLOW_WEB_TRIPS=true
